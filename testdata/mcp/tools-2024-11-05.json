{"tools":[{"name":"session","description":"One coding-agent session: cost, tokens, models, tools, errors, files. No ref = the session calling this tool ('what did this cost so far?').","inputSchema":{"type":"object","properties":{"ref":{"type":"string","pattern":"^[\\w:.][\\w:.-]{0,127}$","description":"current (default), last, parent, id or harness:id"},"root":{"type":"boolean"},"fields":{"type":"array","items":{"type":"string","enum":["id","harness","title","cwd","branch","remote","model","path","updated","bytes","live","pid","status","mux","parent","kind","twins","activity","tokens","costUsd","costEstimatedUsd","billing","unpricedTokens","unpricedCredits","linesAdded","linesRemoved","attention","stuck","skills","repo","alerts","git","turns","wallMs","activeMs","models","tools","errors","files","repeats","subagents","costBasis","via"]},"minItems":1}},"additionalProperties":false}},{"name":"sessions","description":"Coding-agent sessions in this project, newest first: cost, status, attention. Find another agent's session or what ran recently.","inputSchema":{"type":"object","properties":{"since":{"type":"string","pattern":"^(today|[0-9]{1,4}[hd]|[0-9]{4}-[0-9]{2}-[0-9]{2})$","default":"24h"},"live":{"type":"boolean"},"harness":{"type":"string","enum":["claude","codex","fx","pi","opencode","kiro","gemini"]},"filter":{"type":"string","maxLength":512,"description":"e.g. tool is Bash"},"limit":{"type":"integer","minimum":1,"maximum":100,"default":20},"cursor":{"type":"string","maxLength":64},"fields":{"type":"array","items":{"type":"string","enum":["id","harness","title","cwd","branch","remote","model","path","updated","bytes","live","pid","status","mux","parent","kind","subagents","twins","activity","tokens","costUsd","costEstimatedUsd","billing","unpricedTokens","unpricedCredits","tools","linesAdded","linesRemoved","attention","stuck","skills","repo","alerts","git","project"]},"minItems":1}},"additionalProperties":false}},{"name":"errors","description":"Failed tool ca