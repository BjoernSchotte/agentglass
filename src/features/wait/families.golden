# loops, conditions, groups
until gh run view 1 --json status | grep -q completed; do sleep 20; done	gh run view	ci
for f in a b; do sed -n 1p $f; done	sed	other
while true; do pnpm test && break; sleep 5; done	pnpm test	test
while ! curl -sf localhost:3000; do sleep 1; done	curl	net
if [ -f x ]; then pnpm build; fi	pnpm build	build
for i in 1 2 3; do echo $i; done	sh	other
sleep 30 && tail -5 /tmp/x.log	sleep	wait
sleep 60	sleep	wait
wait	wait	wait
while sleep 5; do pgrep -f x || break; done	sleep	wait
