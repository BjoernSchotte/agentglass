{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "meta",
  "title": "Meta",
  "type": "object",
  "required": [
    "version",
    "contract",
    "proto",
    "caps",
    "readOnly",
    "redact",
    "harnesses",
    "teams",
    "fleetHosts"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "contract": {
      "type": "integer"
    },
    "proto": {
      "type": "integer"
    },
    "caps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readOnly": {
      "type": "boolean"
    },
    "redact": {
      "type": "boolean"
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        }
      }
    },
    "fleetHosts": {
      "type": "integer",
      "minimum": 0,
      "description": "fleet hosts configured (fleet.hosts in config.json); the web shows Fleet only with some"
    }
  }
}
