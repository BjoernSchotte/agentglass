{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "team-activity",
  "title": "TeamActivity",
  "type": "object",
  "required": [
    "team",
    "events"
  ],
  "properties": {
    "team": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "at",
          "actor",
          "kind",
          "room",
          "text"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "room": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
