{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patch",
  "title": "ApiPatch",
  "type": "object",
  "required": [
    "upsert",
    "remove"
  ],
  "properties": {
    "upsert": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          }
        }
      }
    },
    "remove": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "indexing": {
      "type": "object",
      "description": "the history index's progress while agentglass indexes (a first run): bytes done and total, bytes per second (0 = not measured yet)",
      "required": [
        "done",
        "total",
        "bps"
      ],
      "properties": {
        "done": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "bps": {
          "type": "number"
        }
      }
    }
  }
}
