{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "patch",
  "title": "ApiPatch",
  "type": "object",
  "required": [
    "upsert",
    "remove"
  ],
  "properties": {
    "upsert": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string"
          }
        }
      }
    },
    "remove": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
