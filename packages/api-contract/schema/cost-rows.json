{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cost-rows",
  "title": "CostRows",
  "description": "cost.get with by, since or filter: the `agentglass cost --by` rows (a final total row) plus by, since, pending, at",
  "type": "object",
  "required": [
    "rows",
    "source",
    "by",
    "since",
    "pending",
    "at"
  ],
  "properties": {
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "in",
          "out",
          "cacheRead",
          "cacheWrite",
          "costUsd",
          "unpricedTokens",
          "sessions"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "in": {
            "type": "number"
          },
          "out": {
            "type": "number"
          },
          "cacheRead": {
            "type": "number"
          },
          "cacheWrite": {
            "type": "number"
          },
          "costUsd": {
            "type": [
              "number",
              "null"
            ]
          },
          "unpricedTokens": {
            "type": "number"
          },
          "sessions": {
            "type": "integer"
          },
          "priceSource": {
            "type": [
              "string",
              "null"
            ]
          },
          "estimated": {
            "type": "boolean"
          },
          "workspaceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "source": {
      "const": "ledger"
    },
    "by": {
      "enum": [
        "day",
        "model",
        "harness",
        "project",
        "session",
        "workspace"
      ]
    },
    "since": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "pending": {
      "type": "integer",
      "minimum": 0,
      "description": "logs of the window the background index has not counted to their end yet (their booked part is in the figures)"
    },
    "at": {
      "type": "number"
    },
    "indexing": {
      "type": "object",
      "required": [
        "done",
        "total"
      ],
      "properties": {
        "done": {
          "type": "number"
        },
        "total": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
